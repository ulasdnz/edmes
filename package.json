{
  "name": "factory-mes-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "build:packages": "tsc -b",
    "build:watch": "tsc -b --watch",
    "build:clean": "tsc -b --clean && turbo run build --force",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "clean": "turbo clean",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo test",
    "test:contract": "turbo run test:contract"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs,json,css,md}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "turbo": "^2.5.4",
    "typescript": "^5.5.0"
  }
}
