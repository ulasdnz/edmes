{
  "name": "production-service",
  "version": "1.0.0",
  "description": "Production microservice for MES",
  "author": "Ulas Deniz Isik",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch --env-file-if-exists=.env src/app.ts",
    "seed": "tsx --env-file-if-exists=.env src/database/seeders/index.ts",
    "migrate": "tsx --env-file-if-exists=.env src/database/migrations/index.ts",
    "migration:create": "tsx src/scripts/create-migration.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@mes/testing": "workspace:*",
    "@testcontainers/mongodb": "^11.14.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.12",
    "jiti": "^2.6.1",
    "supertest": "^7.3.1",
    "swagger-ui-express": "^5.0.1",
    "testcontainers": "^11.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@mes/auth": "workspace:*",
    "@mes/cache": "workspace:*",
    "@mes/core": "workspace:*",
    "@mes/events": "workspace:*",
    "@mes/health": "workspace:*",
    "@mes/logger": "workspace:*",
    "@mes/openapi": "workspace:*",
    "@mes/privileges": "workspace:*",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "i18next": "^25.8.14",
    "i18next-fs-backend": "^2.6.9",
    "i18next-http-middleware": "^3.9.10",
    "ioredis": "^5.10.0",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "uuid": "^13.0.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7",
    "zod-openapi": "^5.4.6"
  },
  "type": "module"
}
