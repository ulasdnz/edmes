    "@types/morgan": "^1.9.10",
    "@types/node": "^25.3.5",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.0.18",
    "jiti": "^2.6.1",
    "mongodb-memory-server": "^11.0.1",
    "swagger-ui-express": "^5.0.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "@mes/testing": "workspace:*",
    "vitest": "^4.0.18"
  },
  "dependencies": {
