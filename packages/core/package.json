{
  "name": "@mes/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pagination": {
      "types": "./dist/pagination.d.ts",
      "import": "./dist/pagination.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  },
  "peerDependencies": {
    "express": "^5.0.0",
    "i18next": "^25.0.0",
    "mongoose": "^9.0.0",
    "winston": "^3.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "mongoose": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mes/testing": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "express": "^5.0.0",
    "i18next": "^25.0.0",
    "mongoose": "^9.2.4",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18",
    "winston": "^3.0.0",
    "zod": "^4.0.0"
  }
}
