{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"],
  "references": [
    { "path": "../packages/cache" },
    { "path": "../packages/core" },
    { "path": "../packages/openapi" },
    { "path": "../packages/auth" },
    { "path": "../packages/logger" }
  ]
}
