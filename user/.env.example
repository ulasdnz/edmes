# Environment Variables Template
# Copy this file to .env and replace the values with your own

# Application
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=supersecretkey
JWT_EXPIRES_IN=1d

# Database (Docker DNS for Dev Containers & Production)
# Use mongodb://localhost:27017/mes for direct host access
# Use mongodb://mongodb:27017/mes for docker bridge network
MONGO_URI=mongodb://mongodb:27017/mes?directConnection=true

# Cache & Queues
REDIS_URL=redis://redis:6379

# Service Discovery
# REQUIRED: Internal URL for this service
INTERNAL_API_USER=http://user:3000

# Logging
LOG_LEVEL=debug

# Features
USER_DELETION_RETENTION_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCKING_DURATION_MS=300000

# Bootstrap System Admin
# Username (system), role name, name, surname are hardcoded — not configurable.
# SYSTEM_ADMIN_PASSWORD is REQUIRED in production. In development, defaults to ChangeMe123!
SYSTEM_ADMIN_BOOTSTRAP_ENABLED=true
SYSTEM_ADMIN_EMAIL=system.admin@example.local
SYSTEM_ADMIN_PASSWORD=
