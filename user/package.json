{
  "name": "user-service",
  "version": "1.0.0",
  "description": "User and Roles microservice for MES",
  "author": "Ulas Deniz Isik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ulasdnz/node-ts-backend-starter.git"
  },
  "bugs": {
    "url": "https://github.com/ulasdnz/node-ts-backend-starter/issues"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "seed": "tsx src/database/seeders/index.ts",
    "migrate": "tsx src/database/migrations/index.ts",
    "migration:create": "tsx src/scripts/create-migration.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@testcontainers/mongodb": "^11.12.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.5",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.0.18",
    "jiti": "^2.6.1",
    "mongodb-memory-server": "^11.0.1",
    "swagger-ui-express": "^5.0.1",
    "supertest": "^7.2.2",
    "testcontainers": "^11.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "@mes/testing": "workspace:*",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@mes/auth": "workspace:*",
    "@mes/cache": "workspace:*",
    "@mes/core": "workspace:*",
    "@mes/logger": "workspace:*",
    "@mes/health": "workspace:*",
    "@mes/openapi": "workspace:*",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "i18next": "^25.8.14",
    "i18next-fs-backend": "^2.6.1",
    "i18next-http-middleware": "^3.9.2",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.4",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6",
    "zod-openapi": "^5.4.6"
  },
  "type": "module"
}
