    "@types/node": "^26.6.5",
    "jsonwebtoken": "^9.0.3",
    "socket.io-client": "^4.8.4",
    "testcontainers": "^11.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@mes/auth": "workspace:*",
    "@mes/cache": "workspace:*",
    "@mes/core": "workspace:*",
    "@mes/events": "workspace:*",
    "@mes/health": "workspace:*",
    "@mes/logger": "workspace:*",
    "express": "^5.3.0",
    "ioredis": "^5.10.0",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
