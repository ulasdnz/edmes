# MES Monorepo Global Environment Variables
# Copy this file to .env in the same directory.
# This file serves as the central "Address Book" for all microservices.

# ─── Secrets (required, docker compose refuses to start without them) ───────
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Shared by all services for /internal/v1 calls (min 32 chars)
INTERNAL_API_TOKEN=
GRAFANA_PASSWORD=
# MQTT broker: the broker hashes these into its password file at every start; telemetry
# connects with MQTT_PASSWORD, the healthcheck with MQTT_HEALTH_PASSWORD
MQTT_PASSWORD=
MQTT_HEALTH_PASSWORD=

# ─── Infrastructure ─────────────────────────────────────────────────────────

# Database (Internal Docker DNS: mongodb)
MONGO_URI=mongodb://mongodb:27017/mes?directConnection=true

# Cache & Queues (Internal Docker DNS: redis)
REDIS_URL=redis://redis:6379

# ─── Internal Service Registry (Address Book) ───────────────────────────────
# Pattern: INTERNAL_API_[SERVICE_NAME]
# Note: These URLs must use the service name defined in docker-compose.yml

# User & Roles Service
INTERNAL_API_USER=http://user:3000

# Station Service (Planned)
# INTERNAL_API_STATION=http://station:3000

# Asset Service (Planned)
# INTERNAL_API_ASSET=http://asset:3000

# Bootstrap System Admin
# Created automatically on first startup by user-service.
# Username (system), role name, name, surname are hardcoded — not configurable.
# SYSTEM_ADMIN_PASSWORD is REQUIRED: docker compose runs the services in production mode, where the
# user service refuses to start without it. Only `pnpm dev` falls back to ChangeMe123!
SYSTEM_ADMIN_BOOTSTRAP_ENABLED=true
SYSTEM_ADMIN_EMAIL=system.admin@example.local
SYSTEM_ADMIN_PASSWORD=
